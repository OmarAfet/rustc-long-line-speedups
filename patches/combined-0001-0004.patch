+/// Checks `lookup_char_pos` (line, column, display column) at every char boundary (and the
+/// end) of files with multi-byte chars, tabs, wide chars, CRLF line ends (normalized) and a
+/// byte-order mark (removed) against the original algorithm written out directly: column =
+/// chars from the line start, display column = `char_width` of those chars up to the newline.
+#[test]
+fn lookup_char_pos_matches_reference() {
+    let sm = SourceMap::new(FilePathMapping::empty());
+    let sources: [&str; 6] = [
+        "fn main() {\n\tlet x = 1;\n}\n",
+        "fir€st €€€€ line.\nsecond line\n\t€\ttab\n",
+        "\u{feff}// bom\r\nlet s = \"\u{4f60}\u{597d}\";\r\n\t\u{1f600} end",
+        "no newline at all, \u{e9}\u{e9}\u{e9} and \t tabs \t",
+        "\n\n\u{200b}\n\t\t\u{202e}x\n",
+        // Lines longer than the 4096-byte direct-scan limit, so the long-line index is used:
+        // tabs, wide, zero-width and multi-byte chars spread along them, a short line between.
+        &format!(
+            "{}\nshort\t\u{4f60}\n{}",
+            "ab\t\u{4f60}c\u{200b}d\u{e9}\u{1f600}efgh".repeat(400),
+            "x\ty\u{202e}z".repeat(1000)
+        ),
+    ];
+    for (i, text) in sources.iter().enumerate() {
+        let sf = sm.new_source_file(filename(&sm, &format!("f{i}.rs")), text.to_string());
+        let src: String = sf.src.as_deref().unwrap().clone();
+        let lines: Vec<usize> = sf.lines().iter().map(|l| l.to_usize()).collect();
+        let positions = src.char_indices().map(|(b, _)| b).chain([src.len()]);
+        for byte in positions {
+            let line_idx = lines.partition_point(|&start| start <= byte) - 1;
+            let line_text = &src[lines[line_idx]..];
+            let col = src[lines[line_idx]..byte].chars().count();
+            let line_text = line_text.split('\n').next().unwrap();
+            let col_display: usize = line_text.chars().take(col).map(char_width).sum();
+            let loc = sm.lookup_char_pos(sf.start_pos + BytePos(byte as u32));
+            assert_eq!(
+                (loc.line, loc.col.0, loc.col_display),
+                (line_idx + 1, col, col_display),
+                "file {i}, byte {byte}"
+            );
+        }
+    }
+}
