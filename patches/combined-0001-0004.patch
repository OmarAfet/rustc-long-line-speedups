+/// Cache of `DisplayWidthIndex`es, one per source file that has a line prefix longer than
+/// `MIN_PREFIX` bytes whose display column was asked for. Lives in the `SourceMap`, so files
+/// without such lines cost nothing. Without it, each display column of a long line needs a scan
+/// of the line prefix, which makes many lookups on one long line (for example panic locations in
+/// generated code written on one line) quadratic.
+#[derive(Default)]
+pub(crate) struct LongLineWidths {
+    indexes: Lock<FxHashMap<BytePos, Arc<DisplayWidthIndex>>>,
+}
+
+impl LongLineWidths {
+    /// Shorter prefixes are scanned directly; that is cheaper than an index lookup.
+    const MIN_PREFIX: usize = 4096;
+
+    fn index_for(&self, sf: &SourceFile, src: &str) -> Arc<DisplayWidthIndex> {
+        // Files are identified by their start position, which is unique within a `SourceMap`.
+        let mut indexes = self.indexes.lock();
+        Arc::clone(indexes.entry(sf.start_pos).or_insert_with(|| {
+            Arc::new(DisplayWidthIndex::new(src, sf.lines(), &sf.multibyte_chars))
+        }))
+    }
+}
+
+/// For the long lines of one file (longer than `LongLineWidths::MIN_PREFIX` bytes): the chars
+/// whose display width is not 1, with the running total of `char_width(ch) - 1`. The display
+/// width of a prefix of such a line is then `chars in the prefix + (total at its end - total at
+/// its start)`: two binary searches.
+pub(crate) struct DisplayWidthIndex {
+    positions: Vec<RelativeBytePos>,
+    running_extra: Vec<i64>,
+}
+
+impl DisplayWidthIndex {
+    fn new(src: &str, lines: &[RelativeBytePos], multibyte_chars: &[MultiByteChar]) -> Self {
+        let (mut positions, mut running_extra, mut total) = (Vec::new(), Vec::new(), 0i64);
+        let mut push = |pos: usize, extra: i64| {
+            total += extra;
+            positions.push(RelativeBytePos(pos as u32));
+            running_extra.push(total);
+        };
+        for (i, &start) in lines.iter().enumerate() {
+            let (start, end) =
+                (start.to_usize(), lines.get(i + 1).map_or(src.len(), |next| next.to_usize()));
+            if end - start <= LongLineWidths::MIN_PREFIX {
+                continue;
+            }
+            // `char_width` is 1 for every ASCII char except tab (4); a newline is never inside a
+            // line prefix. So only tabs and multi-byte chars of this line can have an entry. Both
+            // lists are in source order; merge them.
+            let mut tabs = src.as_bytes()[start..end]
+                .iter()
+                .enumerate()
+                .filter(|&(_, &b)| b == b'\t')
+                .map(|(i, _)| (start + i, 3))
+                .peekable();
+            let first = multibyte_chars.partition_point(|mbc| mbc.pos.to_usize() < start);
+            let mut wide = multibyte_chars[first..]
+                .iter()
+                .take_while(|mbc| mbc.pos.to_usize() < end)
+                .filter_map(|mbc| {
+                    let i = mbc.pos.to_usize();
+                    let extra = char_width(src[i..].chars().next()?) as i64 - 1;
+                    (extra != 0).then_some((i, extra))
+                })
+                .peekable();
+            loop {
+                let take_tab = match (tabs.peek(), wide.peek()) {
+                    (Some(tab), Some(w)) => tab.0 < w.0,
+                    (Some(_), None) => true,
+                    (None, Some(_)) => false,
+                    (None, None) => break,
+                };
+                let (i, extra) = if take_tab { tabs.next() } else { wide.next() }.unwrap();
+                push(i, extra);
+            }
+        }
+        DisplayWidthIndex { positions, running_extra }
+    }
+
+    /// Sum of `char_width(ch) - 1` over the indexed chars that start in `range`.
+    fn extra_width(&self, range: Range<RelativeBytePos>) -> i64 {
+        let total_before = |pos: RelativeBytePos| {
+            let n = self.positions.partition_point(|&p| p < pos);
+            if n == 0 { 0 } else { self.running_extra[n - 1] }
+        };
+        total_before(range.end) - total_before(range.start)
+    }
+}
