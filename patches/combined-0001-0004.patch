+/// matters for very long lines (for example generated code on one line), where this function
+/// is called for many positions on the same line.
+pub(crate) fn prefix_display_width(line: &str, chars: usize) -> usize {
+    let bytes = line.as_bytes();
+    if let Some(prefix) = bytes.get(..chars)
+        && prefix.is_ascii()
+    {
+        let tabs = prefix.iter().filter(|&&b| b == b'\t').count();
+        return chars + 3 * tabs;
+    }
+    line.chars().take(chars).map(char_width).sum()
