diff --git a/compiler/rustc_span/src/tests.rs b/compiler/rustc_span/src/tests.rs
index 64c40e611..276d77f9b 100644
--- a/compiler/rustc_span/src/tests.rs
+++ b/compiler/rustc_span/src/tests.rs
@@ -117,3 +117,30 @@ fn test_unnormalized_source_length() {
     assert_eq!(sf.unnormalized_source_len, 19);
     assert_eq!(sf.normalized_source_len.0, 14);
 }
+
+#[test]
+fn prefix_display_width_matches_char_width() {
+    let lines = [
+        "",
+        "fn main() { let x = 1; }",
+        "\tlet\tx = 1;\t",
+        "a\u{0}b\u{7f}c\rd\u{1b}e",
+        "let s = \"\u{4f60}\u{597d}\"; // wide",
+        "emoji \u{1f600} and zero width \u{200b} here",
+        "\u{202e}bidi\u{2066}x\u{2069}",
+        "tab\tthen \u{e9}\tafter",
+    ];
+    for line in lines {
+        let n = line.chars().count();
+        for chars in 0..=n + 2 {
+            let expected: usize = line.chars().take(chars).map(char_width).sum();
+            assert_eq!(prefix_display_width(line, chars), expected, "line {line:?}, chars {chars}");
+        }
+    }
+    // A long ASCII line, as in generated code.
+    let long = "x, ".repeat(100_000) + "\t\t";
+    for chars in [0, 1, 7, 299_999, 300_000, 300_001, 300_002] {
+        let expected: usize = long.chars().take(chars).map(char_width).sum();
+        assert_eq!(prefix_display_width(&long, chars), expected);
+    }
+}
